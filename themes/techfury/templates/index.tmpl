                    <section class="faq-section" style="margin: 3rem 0; text-align: center;">
                        <h2>FAQ</h2>
                        <div class="faq-list" style="max-width: 700px; margin: 2rem auto; text-align: left;">
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Who is TechFury for?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">TechFury is ideal for DevOps engineers, cloud architects, software developers, IT managers, and anyone interested in learning about modern DevOps practices, AI integration, and cloud technologies. Both beginners and experienced professionals will find valuable content.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Dla kogo jest TechFury?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">TechFury idealna dla inżynierów DevOps, architektów chmury, deweloperów, menedżerów IT i wszystkich zainteresowanych nowoczesnym DevOps, integracją AI i technologiami chmurowymi. Zarówno początkujący jak i doświadczeni profesjonaliści znajdą cenną wiedzę.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">What's included with my ticket?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">All tickets include: full day access to all sessions, lunch and coffee breaks, networking sessions, access to speaker materials. Premium tickets also include a VIP speaker dinner and access to session recordings.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Co obejmuje bilet?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Każdy bilet obejmuje: dostęp do wszystkich sesji przez cały dzień, obiad i przerwy kawowe, sesje networkingowe, dostęp do materiałów prelegentów. Bilety Premium dodatkowo obejmują kolację z prelegentami VIP i dostęp do nagrań sesji.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">What's the format of the sessions?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">We offer a mix of 45-minute keynote talks, technical deep-dives, hands-on workshops, and lightning talks. Sessions are held in English and Polish. Expect interactive Q&A with speakers.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Jaki jest format sesji?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Oferujemy mix 45-minutowych prelekcji, deep-dive'ów technicznych, warsztatów praktycznych i lightning talków. Sesje w języku angielskim i polskim. Spodziewaj się interaktywnych sesji Q&A ze mówcami.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Will there be networking and afterparty?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Absolutely! We have dedicated networking sessions throughout the day, a VIP speaker dinner for Premium ticket holders, and a casual afterparty for all attendees. It's a great opportunity to connect with fellow professionals and speakers.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Czy będzie networking i after party?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Oczywiście! Mamy dedykowane sesje networkingowe przez cały dzień, kolację z prelegentami VIP dla posiadaczy biletów Premium i nieformalne after party dla wszystkich uczestników. To świetna okazja do nawiązania kontaktów z innymi profesjonalistami i mówcami.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">How can I buy a ticket?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Click the "Buy ticket" button at the top of the page or scroll to the pricing section. You'll be redirected to our secure booking system where you can select your ticket tier and complete payment.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Jak mogę kupić bilet?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Kliknij przycisk \"Kup bilet\" na górze strony lub przewiń do sekcji cennika. Zostaniesz przeniesiony do naszego bezpiecznego systemu rezerwacji, gdzie możesz wybrać typ biletu i dokonać płatności.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">What's the refund policy?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">We offer full refunds for cancellations made up to 2 weeks before the event. Cancellations within 2 weeks of the event are non-refundable. Ticket transfers to another person are always allowed at no additional cost.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Czy bilety są zwrotne?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Oferujemy pełny zwrot pieniędzy za anulowanie do 2 tygodni przed wydarzeniem. Anulowania w ciągu 2 tygodni przed wydarzeniem nie podlegają zwrotowi. Możesz zawsze bezpłatnie przenieść bilet na inną osobę.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Is the event in-person?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Yes, TechFury 2026 is a fully in-person event taking place on April 24, 2026 in Szczecin, Poland. All sessions, networking, and meals are conducted on-site.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Czy wydarzenie jest stacjonarne?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Tak, TechFury 2026 jest w pełni stacjonarne i odbędzie się 24 kwietnia 2026 w Szczecinie, Polska. Wszystkie sesje, networking i posiłki odbywają się na terenie obiektu.</div>
                                % endif
                            </div>
                            <div class="faq-item" style="margin-bottom: 1.5rem;">
                                % if lang == 'en':
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Will recordings be available?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Yes, session recordings will be available after the event. Premium ticket holders get immediate access, while Standard ticket holders can access recordings 30 days after the conference.</div>
                                % else:
                                    <button class="faq-question" style="color: var(--fury-primary); font-weight: bold; background:none; border:none; width:100%; text-align:left; font-size:1.1em; cursor:pointer; padding:0;">Czy będą dostępne nagrania?</button>
                                    <div class="faq-answer" style="color: var(--fury-light); display:none; margin-top:0.5em;">Tak, nagrania sesji będą dostępne po wydarzeniu. Posiadacze biletów Premium uzyskują natychmiastowy dostęp, podczas gdy posiadacze biletów Standard mogą uzyskać dostęp 30 dni po konferencji.</div>
                                % endif
                            </div>
                        </div>
                    </section>

                    <!-- Registration/CTA Section -->
                    <section class="registration-section" style="margin: 3rem 0; text-align: center;">
                        % if lang == 'en':
                            <h2>Register today!</h2>
                            <p style="color: var(--fury-light); font-size: 1.2em;">Don't miss the biggest tech conference this spring.</p>
                            <a href="#" class="btn btn-primary btn-lg buy-ticket-btn" style="margin-top:1.5rem;">Reserve your spot</a>
                        % else:
                            <h2>Zarejestruj się już dziś!</h2>
                            <p style="color: var(--fury-light); font-size: 1.2em;">Nie przegap największej konferencji technologicznej tej wiosny.</p>
                            <a href="#" class="btn btn-primary btn-lg buy-ticket-btn" style="margin-top:1.5rem;">Zarezerwuj miejsce</a>
                        % endif
                    </section>
                    <!-- Landing Page Content End -->
                % endif

                <%block name="content"></%block>
            </div>
        </div>
        <footer class="footer">
            ${footer.html_footer()}
        </footer>
    </div>
    ${base.late_load_js()}
    <!-- Modal for ticket purchase -->
    <div id="ticket-modal" style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.7); z-index:9999; align-items:center; justify-content:center;">
        <div style="background:var(--fury-dark); color:var(--fury-light); padding:2rem 2.5rem; border-radius:10px; max-width:600px; margin:auto; text-align:center; position:relative;">
            <button id="close-modal" style="position:absolute; top:0.5em; right:0.5em; background:none; border:none; color:var(--fury-light); font-size:1.5em; cursor:pointer;">&times;</button>
            <h3>Kup bilet</h3>
            <iframe src="https://app.evenea.pl/event/techfury2026/?out=1&source=event_iframe" width="100%" scrolling="no" style="border: 0;"></iframe>
<script type="text/javascript" src="https://app.evenea.pl/js/iframe/new/iframeResizer2.js"></script>
        </div>
    </div>
    <!-- Countdown Timer Script -->
    <script>
    // Countdown to conference start (April 24, 2026 at 10:00 AM)
    function updateCountdown() {
        var conferenceDate = new Date('2026-04-24T10:00:00').getTime();
        var now = new Date().getTime();
        var distance = conferenceDate - now;

        var days = Math.floor(distance / (1000 * 60 * 60 * 24));
        var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        var seconds = Math.floor((distance % (1000 * 60)) / 1000);

        var countdownEl = document.getElementById('countdown');
        if (countdownEl) {
            if (distance > 0) {
                countdownEl.textContent = days + 'd ' + hours + 'h ' + minutes + 'm ' + seconds + 's';
            } else {
                countdownEl.textContent = 'Conference has started';
            }
        }
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);
    </script>

    <!-- Interactivity: FAQ accordion, smooth scroll, modal -->
    <script>
    // FAQ accordion
    document.querySelectorAll('.faq-question').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var answer = btn.nextElementSibling;
            var isOpen = answer.style.display === 'block';
            document.querySelectorAll('.faq-answer').forEach(function(a) { a.style.display = 'none'; });
            if (!isOpen) answer.style.display = 'block';
        });
    });
    // Modal for ticket purchase
    document.querySelectorAll('.buy-ticket-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('ticket-modal').style.display = 'flex';
        });
    });
    document.getElementById('close-modal').onclick = function() {
        document.getElementById('ticket-modal').style.display = 'none';
    };
    // Smooth scroll for nav links
    document.querySelectorAll('.nav-link').forEach(function(link) {
        link.addEventListener('click', function(e) {
            var href = link.getAttribute('href');
            if (href.startsWith('#')) {
                e.preventDefault();
                document.querySelector(href).scrollIntoView({ behavior: 'smooth' });
            }
        });
    });
    </script>
    ${body_end}
    ${template_hooks['body_end']()}
</body>
</html>